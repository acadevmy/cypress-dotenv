{
  "name": "@devmy/cypress-dotenv",
  "version": "1.0.0",
  "description": "integrate `dotenv` configuration with `@dotenv-run/core` into your Cypress setup, simplifying the management of environment variables for both component and end-to-end (E2E) tests.",
  "type": "commonjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.mjs",
    "require": "./dist/index.js",
    "default": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint 'lib/**/*.ts'",
    "lint:fix": "eslint 'lib/**/*.ts' --fix",
    "release": "semantic-release",
    "test": "vitest run"
  },
  "keywords": [
    "cypress",
    "dotenv",
    "environment variables",
    "testing",
    "typescript",
    "component testing",
    "end-to-end testing",
    "e2e",
    "cypress config",
    "env",
    "dotenv-run",
    ".env.vault",
    "vault",
    "dotenv_key"
  ],
  "license": "MIT",
  "author": ".devmy",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acadevmy/cypress-dotenv.git"
  },
  "bugs": {
    "url": "https://github.com/acadevmy/cypress-dotenv/issues"
  },
  "dependencies": {
    "@dotenv-run/core": "^1.3.8",
    "lodash": "^4.18.1"
  },
  "peerDependencies": {
    "cypress": "^15.0.0 || ^16.0.0"
  },
  "devDependencies": {
    "@devmy/eslint-plugin": "^1.3.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/lodash": "^4.17.27",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "cypress": "16.2.1",
    "eslint": "9.39.5",
    "eslint-plugin-cypress": "6.4.4",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.15.0"
  },
  "pnpm": {
    "executionEnv": {
      "nodeVersion": "24.22.2"
    }
  }
}
